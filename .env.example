# Environment variables for the Luminedge Booking Portal (Next.js frontend).
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# This frontend does NOT use MongoDB — do not add MONGODB_URI here.

# Backend API base URL (defaults to the prod backend if unset).
NEXT_PUBLIC_API_BASE_URL=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
# CLIENT ID is public; CLIENT SECRET must be server-only (never NEXT_PUBLIC_).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
